{
  "manifest_version": 3,
  "name": "PricePeel – real prices for AliExpress",
  "short_name": "PricePeel",
  "version": "1.0.0",
  "homepage_url": "https://pricepeel.benkol.com/",
  "description": "See the real price of the item in the photo on AliExpress search results, not the price of a cheap accessory variant.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.aliexpress-media.com/*",
    "https://*.alicdn.com/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-32.png"],
      "matches": ["https://*.aliexpress.com/*", "https://*.aliexpress.us/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*.aliexpress.com/*", "https://*.aliexpress.us/*"],
      "exclude_matches": ["https://*.aliexpress.com/item/*", "https://*.aliexpress.us/item/*"],
      "js": ["src/bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.aliexpress.com/*", "https://*.aliexpress.us/*"],
      "exclude_matches": ["https://*.aliexpress.com/item/*", "https://*.aliexpress.us/item/*"],
      "js": ["src/analyze.js", "src/content.js"],
      "css": ["src/label.css"],
      "run_at": "document_idle"
    }
  ]
}
